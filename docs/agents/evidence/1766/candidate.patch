From 1c0bdb323ba697979ea5265c52a15c4d21993e1f Mon Sep 17 00:00:00 2001
From: Chris Banes <chris@banes.me>
Date: Thu, 12 Nov 2026 15:00:58 +0000
Subject: [PATCH] Skip the flat interior lighting gradient for circular Glass

Past the refraction zone the surface height is constant, so the four
neighbouring height samples of the lighting gradient are equal and the
gradient is exactly zero. Circular fields are 1-Lipschitz, so a centre a
pixel beyond the zone plus sampleStep guarantees every sample is too.
Continuous corners keep sampling.

Related to #1766
---
 .../dev/chrisbanes/haze/glass/GlassShaders.kt | 12 +++++++++-
 .../haze/glass/GlassShadersGoldenTest.kt      | 24 ++++++++++---------
 2 files changed, 24 insertions(+), 12 deletions(-)

diff --git a/haze-glass/src/commonMain/kotlin/dev/chrisbanes/haze/glass/GlassShaders.kt b/haze-glass/src/commonMain/kotlin/dev/chrisbanes/haze/glass/GlassShaders.kt
index 5b82aa1ec..ee7160823 100644
--- a/haze-glass/src/commonMain/kotlin/dev/chrisbanes/haze/glass/GlassShaders.kt
+++ b/haze-glass/src/commonMain/kotlin/dev/chrisbanes/haze/glass/GlassShaders.kt
@@ -1004,7 +1004,7 @@ ${ifContinuous(continuous, "        vec4 exponents = memberCornerExponents[i];\n
         float t = clamp(opticalDistance / refractionZone, 0.0, 1.0);
         float lightingSlope = 2.0 * (1.0 - smootherstep(t));
         return opticalSurfaceGradient(localCoord, fieldWeight) * lightingSlope;
-      }
+      }${if (continuous) "" else FLAT_INTERIOR_LIGHTING_GRADIENT}
       return surfaceGradient(localCoord, fieldWeight);
     }
 
@@ -1461,6 +1461,16 @@ ${ifContinuous(continuous, "        vec4 exponents = memberCornerExponents[i];\n
       );
     }"""
 
+  /**
+   * Past the refraction zone every surface profile is flat, so the four height samples of
+   * `surfaceGradient` are equal and its result is exactly zero. Circular fields, including their
+   * smooth union, are 1-Lipschitz, so each sample (at most `sampleStep` away) is still past the zone
+   * when the centre is a pixel beyond it; the pixel absorbs rounding. Continuous corners use an
+   * approximate distance without that bound, so they always sample (#1766).
+   */
+  private const val FLAT_INTERIOR_LIGHTING_GRADIENT = """
+      if (fieldWeight <= 0.0 && -sd >= max(refractionHeight, 0.0001) + sampleStep + 1.0) return vec2(0.0);"""
+
   private fun mergedShapeHelpers(merged: Boolean, continuous: Boolean, tint: Boolean = false): String = when {
     !merged -> ""
     tint -> MERGED_MEMBER_TINTS + mergedFieldHelpers(continuous) + MERGED_OPTICS_HELPERS
