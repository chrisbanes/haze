+class AdaptiveEdgePrototypeIntegrationTest : ContextTest() {
+  @Suppress("DEPRECATION")
+  @Test
+  fun sourceChange_updatesExperimentalForeground() = checkSourceChange(HazePerformanceMode.Quality, 0f)
+
+  @Suppress("DEPRECATION")
+  @Test
+  fun scaledFractionalSourceChange_updatesExperimentalForeground() = checkSourceChange(HazePerformanceMode.Performance, 0.5f)
+
+  @Suppress("DEPRECATION")
+  private fun checkSourceChange(mode: HazePerformanceMode, translation: Float) = runSkikoComposeUiTest(
+    size = Size(128f, 96f),
+    density = Density(1f),
+  ) {
+    val state = HazeState()
+    val offset = mutableStateOf(0f)
+    val attached = mutableStateOf(true)
+    val effect = GlassRuntimeEffect()
+    val factory = HazeEffectFactory { effect }
+    val style = GlassStyle.regular.then {
+      shape(RoundedCornerShape(8.dp))
+      backgroundColor(Color.Transparent)
+    }
+    setContent {
+      CompositionLocalProvider(LocalSystemTheme provides SystemTheme.Light) {
+        Box(Modifier.size(128.dp, 96.dp).testTag("root").background(Color.Black)) {
+          Box(
+            Modifier.size(128.dp, 96.dp).hazeSource(state).drawBehind {
+              drawRect(Color(0.1f, 0.1f, 0.1f))
+              drawRect(Color(0.9f, 0.9f, 0.9f), topLeft = Offset(64f + offset.value, 0f))
+            },
+          )
+          if (attached.value) {
+            Box(
+              Modifier.offset(16.dp, 16.dp).graphicsLayer {
+                translationX = translation
+                translationY = translation
+              }.size(96.dp, 64.dp).hazeGlass(factory, HazeInput.Sources(state), style, mode, true, null),
+            )
+          }
+        }
+      }
+    }
+    waitForIdle()
+    val delegate = effect.delegate as RuntimeShaderGlassDelegate
+    val shader = adaptiveEdgeShader()
+    val program = RuntimeEffect.makeForShader(shader)
+    val fixed = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+    var recordedKey: GlassRimEffectKey? = null
+    fun installAdaptive(gain: Float) {
+      delegate.experimentalRim = { source, layer, key ->
+        recordedKey = key
+        layer.alpha = 1f
+        layer.renderEffect = createRuntimeShaderRenderEffect(program, arrayOf("content"), arrayOf(null)) {
+          setRimUniforms(key)
+          setFloatUniform("rimGain", gain)
+          setFloatUniform("outlineGain", gain)
+        }.asComposeRenderEffect()
+        recordGlassLayer(layer, key.coordinates.sampleSize.roundToIntSize()) { drawLayer(source) }
+      }
+      checkNotNull(effect.attachedContextForTest).invalidateDraw()
+    }
+    fun install(gain: Float) {
+      if (gain.coerceIn(0f, 1f) == 0f) {
+        delegate.experimentalRim = null
+        checkNotNull(effect.attachedContextForTest).invalidateDraw()
+      } else {
+        installAdaptive(gain)
+      }
+    }
+    try {
+      for (adaptiveZeroControl in listOf(true, false)) {
+        runOnIdle { if (adaptiveZeroControl) installAdaptive(0f) else install(0f) }
+        if (!adaptiveZeroControl) assertThat(delegate.experimentalRim).isNull()
+        onNodeWithTag("root").captureToImage().toPixelMap()
+        val zero = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+        var identityDifference = 0f
+        for (y in 0 until fixed.height) for (x in 0 until fixed.width) {
+          val a = fixed[x, y]
+          val b = zero[x, y]
+          identityDifference = maxOf(identityDifference, abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha))
+        }
+        assertThat(identityDifference).isLessThanOrEqualTo(1f / 255f)
+      }
+      runOnIdle { offset.value = 8f }
+      val fixedShiftedScreen = onNodeWithTag("root").captureToImage().toPixelMap()
+      runOnIdle { offset.value = 0f }
+      onNodeWithTag("root").captureToImage()
+      runOnIdle { install(1f) }
+      onNodeWithTag("root").captureToImage().toPixelMap()
+      val before = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+      val coordinates = checkNotNull(recordedKey).coordinates
+      var checkedLeft = 0
+      var checkedRight = 0
+      var leftMultiplier = 0f
+      var rightMultiplier = 0f
+      var leftDelta = 0f
+      var rightDelta = 0f
+      var error = 0f
+      for (y in 0 until before.height) for (x in 0 until before.width) {
+        val screenX = 16f + translation + (x + 0.5f - coordinates.materialOrigin.x) / coordinates.scaleFactor
+        val screenY = 16f + translation + (y + 0.5f - coordinates.materialOrigin.y) / coordinates.scaleFactor
+        val inEdge = if (translation == 0f) screenY >= 32f && screenY < 64f && (screenX >= 16f && screenX < 20f || screenX >= 108f && screenX < 112f) else screenY >= 33f && screenY < 63f && (screenX >= 17f && screenX < 20f || screenX >= 109f && screenX < 112f)
+        if (inEdge) {
+          val fixedAlpha = fixed[x, y].alpha
+          if (fixedAlpha >= 0.05f) {
+            val encoded = if (screenX < 64f) 26.0 / 255.0 else 230.0 / 255.0
+            val linear = Math.pow((encoded + 0.055) / 1.055, 2.4).toFloat()
+            error = maxOf(error, abs(before[x, y].alpha - (fixedAlpha * (0.5f + linear)).coerceIn(0f, 1f)))
+            if (screenX < 64f) {
+              checkedLeft++
+              leftMultiplier += before[x, y].alpha / fixedAlpha
+              leftDelta += before[x, y].alpha - fixedAlpha
+            } else {
+              checkedRight++
+              rightMultiplier += before[x, y].alpha / fixedAlpha
+              rightDelta += before[x, y].alpha - fixedAlpha
+            }
+          }
+        }
+      }
+      assertThat(checkedLeft).isGreaterThan(0)
+      assertThat(checkedRight).isGreaterThan(0)
+      assertThat(error).isLessThanOrEqualTo(2f / 255f)
+      assertThat(rightMultiplier / checkedRight - leftMultiplier / checkedLeft).isGreaterThan(3f / 255f)
+      assertThat(rightDelta / checkedRight - leftDelta / checkedLeft).isGreaterThan(3f / 255f)
+      val drawsBeforeStep = delegate.experimentalForegroundDrawCount
+      runOnIdle { offset.value = 8f }
+      val shiftedScreen = onNodeWithTag("root").captureToImage().toPixelMap()
+      val drawsAfterStep = delegate.experimentalForegroundDrawCount - drawsBeforeStep
+      assertThat(drawsAfterStep).isLessThanOrEqualTo(1)
+      var screenDifference = 0f
+      var interiorDifference = 0f
+      for (y in 0 until shiftedScreen.height) for (x in 0 until shiftedScreen.width) {
+        val a = shiftedScreen[x, y]
+        val b = fixedShiftedScreen[x, y]
+        val difference = maxOf(abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha))
+        if (x in 64 until 72 && y in 16 until 20) screenDifference = maxOf(screenDifference, difference)
+        if (x in 32 until 96 && y in 32 until 64) interiorDifference = maxOf(interiorDifference, difference)
+      }
+      assertThat(screenDifference).isGreaterThan(3f / 255f)
+      assertThat(interiorDifference).isLessThanOrEqualTo(1f / 255f)
+      val after = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+      var difference = 0f
+      var changedMaskPixels = 0
+      var stepError = 0f
+      for (y in 0 until before.height) for (x in 0 until before.width) {
+        val screenX = 16f + translation + (x + 0.5f - coordinates.materialOrigin.x) / coordinates.scaleFactor
+        val screenY = 16f + translation + (y + 0.5f - coordinates.materialOrigin.y) / coordinates.scaleFactor
+        val inStep = if (translation == 0f) screenX >= 64f && screenX < 72f && screenY >= 16f && screenY < 20f else screenX >= 66f && screenX < 70f && screenY >= 17f && screenY < 20f
+        if (inStep && fixed[x, y].alpha >= 0.05f) {
+          difference = maxOf(difference, abs(before[x, y].alpha - after[x, y].alpha))
+          val encoded = 26.0 / 255.0
+          val linear = Math.pow((encoded + 0.055) / 1.055, 2.4).toFloat()
+          stepError = maxOf(stepError, abs(after[x, y].alpha - fixed[x, y].alpha * (0.5f + linear)))
+          changedMaskPixels++
+        }
+      }
+      assertThat(changedMaskPixels).isGreaterThan(0)
+      assertThat(stepError).isLessThanOrEqualTo(2f / 255f)
+      assertThat(difference).isGreaterThan(3f / 255f)
+      runOnIdle {
+        delegate.clearRetainedOutput()
+        checkNotNull(effect.attachedContextForTest).invalidateDraw()
+      }
+      onNodeWithTag("root").captureToImage()
+      val recreated = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+      var restorationError = 0f
+      for (y in 0 until after.height) for (x in 0 until after.width) {
+        restorationError = maxOf(restorationError, abs(after[x, y].alpha - recreated[x, y].alpha))
+      }
+      assertThat(restorationError).isLessThanOrEqualTo(1f / 255f)
+      System.getenv("HAZE_T2_ARTIFACT_DIR")?.let { output ->
+        File(output).mkdirs()
+        File(output, "t1-metrics-${if (translation == 0f) "quality" else "half-scale"}.txt").writeText(
+          "left=$checkedLeft right=$checkedRight alphaMaxError=$error stepPixels=$changedMaskPixels stepMaxError=$stepError " +
+            "stepMaxDifference=$difference screenMaxDifference=$screenDifference interiorMaxDifference=$interiorDifference " +
+            "foregroundCalls=$drawsAfterStep restorationMaxError=$restorationError\n",
+        )
+      }
+      runOnIdle { attached.value = false }
+      waitForIdle()
+      assertThat(delegate.experimentalRim).isNull()
+      assertThat(delegate.layers.isEmpty).isTrue()
+    } finally {
+      runOnIdle { delegate.experimentalRim = null }
+    }
+  }
+}
