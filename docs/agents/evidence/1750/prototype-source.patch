+      val adaptiveRim = runBlocking { checkNotNull(delegate.layers.rim).toImageBitmap() }.toPixelMap()
+      var difference = 0f
+      for (y in 16 until 80) for (x in 16 until 112) {
+        difference = maxOf(difference, abs(fixed[x, y].red - adaptive[x, y].red))
+      }
+      assertThat(difference).isGreaterThan(3f / 255f)
