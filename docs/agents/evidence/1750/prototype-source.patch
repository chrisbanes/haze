+            )
+          }
+        }
+      }
+    }
+    onNodeWithTag("lifecycle-root").captureToImage()
+    runOnIdle { shift.value = 8f }
+    val fixedShift = onNodeWithTag("lifecycle-root").captureToImage().toPixelMap()
+    runOnIdle { shift.value = 0f }
+    onNodeWithTag("lifecycle-root").captureToImage()
+    fun install(delegate: RuntimeShaderGlassDelegate) {
+      val candidate = createRuntimeEffect(adaptiveEdgeShader())
+      delegate.experimentalRim = { source, layer, key ->
+        layer.alpha = 1f
+        layer.renderEffect = createRuntimeShaderRenderEffect(candidate, arrayOf("content"), arrayOf(null)) {
+          setRimUniforms(key)
+          setFloatUniform("rimGain", 1f)
+          setFloatUniform("outlineGain", 1f)
+        }.asComposeRenderEffect()
+        recordGlassLayer(layer, key.coordinates.sampleSize.roundToIntSize()) { drawLayer(source) }
+      }
+      checkNotNull(effect.attachedContextForTest).invalidateDraw()
+    }
+    fun maxDifference(a: PixelMap, b: PixelMap, xRange: IntRange, yRange: IntRange): Float {
+      var difference = 0f
+      for (y in yRange) for (x in xRange) {
+        val p = a[x, y]
+        val q = b[x, y]
+        difference = maxOf(difference, abs(p.red - q.red), abs(p.green - q.green), abs(p.blue - q.blue), abs(p.alpha - q.alpha))
+      }
+      return difference
+    }
+    var delegate = effect.delegate as RuntimeShaderGlassDelegate
+    assertThat(delegate.fusedShader).isNotNull()
+    try {
+      runOnIdle { install(delegate) }
+      onNodeWithTag("lifecycle-root").captureToImage()
+      runOnIdle { shift.value = 8f }
+      val shifted = onNodeWithTag("lifecycle-root").captureToImage().toPixelMap()
+      assertThat(maxDifference(fixedShift, shifted, 64..71, 16..19)).isGreaterThan(3f / 255f)
+      val repeated = onNodeWithTag("lifecycle-root").captureToImage().toPixelMap()
+      assertThat(maxDifference(shifted, repeated, 0..127, 0..95)).isLessThanOrEqualTo(1f / 255f)
+      runOnIdle {
+        delegate.clearRetainedOutput()
+        checkNotNull(effect.attachedContextForTest).invalidateDraw()
+      }
+      val recreated = onNodeWithTag("lifecycle-root").captureToImage().toPixelMap()
+      assertThat(maxDifference(shifted, recreated, 0..127, 0..95)).isLessThanOrEqualTo(1f / 255f)
+      runOnIdle { effect.onTrimMemory(TrimMemoryLevel.MODERATE) }
+      assertThat(delegate.layers.isEmpty).isTrue()
+      val trimmed = onNodeWithTag("lifecycle-root").captureToImage().toPixelMap()
+      assertThat(maxDifference(shifted, trimmed, 0..127, 0..95)).isLessThanOrEqualTo(1f / 255f)
+      runOnIdle { attached.value = false }
+      waitForIdle()
+      assertThat(delegate.experimentalRim).isNull()
+      assertThat(delegate.layers.isEmpty).isTrue()
+      runOnIdle { attached.value = true }
+      onNodeWithTag("lifecycle-root").captureToImage()
+      delegate = effect.delegate as RuntimeShaderGlassDelegate
+      runOnIdle { install(delegate) }
+      val reattached = onNodeWithTag("lifecycle-root").captureToImage().toPixelMap()
+      assertThat(maxDifference(shifted, reattached, 0..127, 0..95)).isLessThanOrEqualTo(1f / 255f)
+    } finally {
+      runOnIdle { delegate.experimentalRim = null }
+    }
+  }
