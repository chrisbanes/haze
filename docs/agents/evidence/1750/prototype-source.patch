+  private fun still(background: String, mode: String) = scene(background) { effect, delegate, sourceShift, surfaceShift, styleState ->
+    val original = capture()
+    val optical = checkNotNull(delegate.layers.optical).toImageBitmap().toPixelMap()
+    install(effect, delegate, mode)
+    if (mode != "fixed") assertThat(delegate.experimentalRim).isNotNull()
+    val actual = capture()
+    assertInterior(original, actual)
+    assertThat(maxDifference(optical, checkNotNull(delegate.layers.optical).toImageBitmap().toPixelMap())).isLessThanOrEqualTo(1f / 255f)
+    if (mode == "fixed") assertThat(maxDifference(original, actual)).isLessThanOrEqualTo(1f / 255f)
+    save(actual, "still/$background-$mode.png")
+  }
+
+  private fun motion(background: String, mode: String) = scene(background) { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, mode)
+    val artifactDir = if (mode == "combined") "motion/$background" else "motion-modes/$background/$mode"
+    val times = StringBuilder("frame,seconds,source_shift_px\n")
+    var previous: PixelMap? = null
+    var stationary: PixelMap? = null
+    var changing = 0
+    for (frame in 0 until 120) {
+      val position = minOf(frame, 89)
+      runOnIdle { sourceShift.value = position.toFloat() }
+      val image = capture()
+      previous?.let { if (maxDifference(it, image) > 1f / 255f) changing++ }
+      if (frame == 89) stationary = image
+      if (frame >= 90) assertThat(maxDifference(checkNotNull(stationary), image)).isLessThanOrEqualTo(1f / 255f)
+      save(image, "$artifactDir/frame-${frame.toString().padStart(4, '0')}.png")
+      times.append("$frame,${frame / 60.0},$position\n")
+      previous = image
+    }
+    assertThat(changing).isGreaterThan(0)
+    output?.let { root -> File(root, "$artifactDir/timestamps.csv").writeText(times.toString()) }
+  }
+
+  private fun materialOnly(background: String) = scene(background) { effect, delegate, sourceShift, surfaceShift, styleState ->
+    val before = capture()
+    val optical = checkNotNull(delegate.layers.optical).toImageBitmap().toPixelMap()
+    runOnIdle {
+      styleState.value = baseStyle().then {
+        specularIntensity(0f)
+        edgeShadow(Color.Transparent)
+        rimHighlight(0f, 3.dp, 1f)
+        edgeOutline(Color.Transparent, 0.dp)
+      }
+    }
+    val after = capture()
+    assertInterior(before, after)
+    assertThat(maxDifference(optical, checkNotNull(delegate.layers.optical).toImageBitmap().toPixelMap())).isLessThanOrEqualTo(1f / 255f)
+    save(after, "material-only/$background.png")
+  }
+
+  private fun surfaceMove() = scene("split") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "combined")
+    val before = capture()
+    runOnIdle { surfaceShift.value = 8f }
+    val after = capture()
+    assertThat(sourceShift.value).isEqualTo(0f)
+    assertThat(maxDifference(before, after)).isGreaterThan(1f / 255f)
+    save(before, "surface-move/before.png")
+    save(after, "surface-move/after.png")
+  }
+
+  private fun outlineColours() = scene("split") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "outline")
+    val redScreen = capture()
+    val red = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+    runOnIdle { styleState.value = baseStyle().then { edgeOutline(Color.Cyan.copy(alpha = 0.5f), 2.dp) } }
+    val cyanScreen = capture()
+    val cyan = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+    assertInterior(redScreen, cyanScreen)
+    var redDominance = 0f
+    var cyanDominance = 0f
+    for (y in 0 until red.height) for (x in 0 until red.width) {
+      if (red[x, y].alpha >= 0.05f) redDominance = maxOf(redDominance, red[x, y].red - red[x, y].green)
+      if (cyan[x, y].alpha >= 0.05f) cyanDominance = maxOf(cyanDominance, cyan[x, y].green - cyan[x, y].red)
+    }
+    assertThat(redDominance).isGreaterThan(0.5f)
+    assertThat(cyanDominance).isGreaterThan(0.5f)
+    save(redScreen, "controls/outline-red.png")
+    save(cyanScreen, "controls/outline-cyan.png")
+  }
+
+  private fun transparentOutline() = scene("split") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "outline")
+    val visible = capture()
+    runOnIdle { styleState.value = baseStyle().then { edgeOutline(Color.Red.copy(alpha = 0f), 2.dp) } }
+    val transparent = capture()
+    assertInterior(visible, transparent)
+    assertThat(maxDifference(visible, transparent)).isGreaterThan(1f / 255f)
+    install(effect, delegate, "fixed")
+    val fixed = capture()
+    assertThat(maxDifference(transparent, fixed)).isLessThanOrEqualTo(1f / 255f)
+    save(transparent, "controls/outline-alpha-zero.png")
+  }
+
+  private fun zeroRim() = scene("split") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "rim")
+    val active = capture()
+    runOnIdle { styleState.value = baseStyle().then { rimHighlight(0f, 3.dp, 1f) } }
+    val zero = capture()
+    assertInterior(active, zero)
+    assertThat(maxDifference(active, zero)).isGreaterThan(1f / 255f)
+    save(zero, "controls/rim-intensity-zero.png")
+  }
+
+  private fun gainControl() = scene("split") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "combined", 0f)
+    capture()
+    assertThat(delegate.experimentalRim).isNull()
+    val zero = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+    install(effect, delegate, "combined", 0.5f)
+    val middleScreen = capture()
+    val middle = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+    install(effect, delegate, "combined", 1f)
+    val fullScreen = capture()
+    val full = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+    var checked = 0
+    for (y in 0 until zero.height) for (x in 0 until zero.width) {
+      val a = zero[x, y].alpha
+      val b = middle[x, y].alpha
+      val c = full[x, y].alpha
+      if (a >= 0.05f && a < 0.7f) {
+        assertThat(b + 2f / 255f >= minOf(a, c) && b - 2f / 255f <= maxOf(a, c)).isTrue()
+        checked++
+      }
+    }
+    assertThat(checked).isGreaterThan(0)
+    assertInterior(middleScreen, fullScreen)
+    save(middleScreen, "controls/gain-half.png")
+    save(fullScreen, "controls/gain-one.png")
+  }
+
+  private fun continuousCornersControl() = scene("split") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "combined")
+    val circular = capture()
+    runOnIdle { styleState.value = baseStyle().then { shape(ContinuousRoundedCornerShape(8.dp, 0.6f)) } }
+    val continuous = capture()
+    assertThat(maxDifference(circular, continuous)).isGreaterThan(1f / 255f)
+    save(continuous, "controls/continuous-corners.png")
+  }
+
+  private fun directionalControl() = scene("split") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "rim")
+    val allSides = capture()
+    runOnIdle { styleState.value = baseStyle().then { rimHighlight(0.4f, 3.dp, 0f) } }
+    val topBottom = capture()
+    assertInterior(allSides, topBottom)
+    assertThat(maxDifference(allSides, topBottom)).isGreaterThan(1f / 255f)
+    save(topBottom, "controls/rim-sides-zero.png")
+  }
+
+  private fun appearanceControl() = scene("split", SystemTheme.Dark) { effect, delegate, sourceShift, surfaceShift, styleState ->
+    val fixed = capture()
+    install(effect, delegate, "combined")
+    val adaptive = capture()
+    assertInterior(fixed, adaptive)
+    assertThat(delegate.experimentalRim).isNotNull()
+    save(fixed, "controls/dark-fixed.png")
+    save(adaptive, "controls/dark-combined.png")
+  }
+
+  private fun grayRamp() = scene("ramp") { effect, delegate, sourceShift, surfaceShift, styleState ->
+    install(effect, delegate, "combined")
+    var previous: PixelMap? = null
+    var maximum = 0
+    for (frame in 0 until 120) {
+      runOnIdle { sourceShift.value = frame.toFloat() }
+      capture()
+      val rim = checkNotNull(delegate.layers.rim).toImageBitmap().toPixelMap()
+      previous?.let { old ->
+        for (y in 0 until rim.height) for (x in 0 until rim.width) {
+          maximum = maxOf(maximum, abs((rim[x, y].toArgb() ushr 24) - (old[x, y].toArgb() ushr 24)))
+        }
+      }
+      previous = rim
+    }
+    assertThat(maximum).isLessThanOrEqualTo(2)
+  }
+
+  private fun scene(
+    background: String,
+    appearance: SystemTheme = SystemTheme.Light,
+    block: suspend androidx.compose.ui.test.ComposeUiTest.(GlassRuntimeEffect, RuntimeShaderGlassDelegate, androidx.compose.runtime.MutableState<Float>, androidx.compose.runtime.MutableState<Float>, androidx.compose.runtime.MutableState<GlassStyle>) -> Unit,
+  ) = runSkikoComposeUiTest(size = Size(128f, 96f), density = Density(1f)) {
+    val state = HazeState()
+    val sourceShift = mutableStateOf(0f)
+    val surfaceShift = mutableStateOf(0f)
+    val effect = GlassRuntimeEffect()
+    val factory = HazeEffectFactory { effect }
+    val photo: ImageBitmap? = if (background == "photo") {
+      val bytes = checkNotNull(javaClass.getResourceAsStream("/adaptive-edge-photo.jpg")).use { it.readBytes() }
+      Image.makeFromEncoded(bytes).toComposeImageBitmap()
+    } else {
+      null
+    }
+    val style = mutableStateOf(baseStyle())
+    setContent {
+      CompositionLocalProvider(LocalSystemTheme provides appearance) {
+        Box(Modifier.size(128.dp, 96.dp).testTag("matrix-root").background(Color.Black)) {
+          Box(
+            Modifier.size(128.dp, 96.dp).hazeSource(state).drawBehind {
+              val shift = sourceShift.value
+              val dark = Color(0.1f, 0.1f, 0.1f)
+              val light = Color(0.9f, 0.9f, 0.9f)
+              when (background) {
+                "light" -> drawRect(light)
+                "dark" -> drawRect(dark)
+                "ramp" -> {
+                  val v = 0.1f + 0.8f * shift / 119f
+                  drawRect(Color(v, v, v))
+                }
+                "split" -> {
+                  drawRect(dark)
+                  drawRect(light, topLeft = Offset(64f + shift, 0f))
+                }
+                "checker" -> {
+                  drawRect(dark)
+                  for (y in 0 until 12) for (x in -16 until 32) {
+                    if ((x + y) % 2 == 0) drawRect(light, topLeft = Offset(x * 8f + shift, y * 8f), size = Size(8f, 8f))
+                  }
+                }
+                "photo" -> drawImage(checkNotNull(photo), dstOffset = IntOffset(-shift.toInt(), 0), dstSize = IntSize(256, 170))
+                else -> error("unknown backdrop: $background")
+              }
+            },
+          )
+          Box(Modifier.offset((16f + surfaceShift.value).dp, 16.dp).size(96.dp, 64.dp).hazeGlass(factory, HazeInput.Sources(state), style.value, HazePerformanceMode.Quality, true, null))
+        }
+      }
+    }
+    waitForIdle()
+    val delegate = effect.delegate as RuntimeShaderGlassDelegate
+    try {
+      block(effect, delegate, sourceShift, surfaceShift, style)
+    } finally {
+      runOnIdle { delegate.experimentalRim = null }
+    }
+  }
+
+  private fun baseStyle() = GlassStyle.regular.then {
+    shape(RoundedCornerShape(8.dp))
+    backgroundColor(Color.Transparent)
+    rimHighlight(0.4f, 3.dp, 1f)
+    edgeOutline(Color.Red.copy(alpha = 0.5f), 2.dp)
+  }
+
+  private fun androidx.compose.ui.test.ComposeUiTest.install(effect: GlassRuntimeEffect, delegate: RuntimeShaderGlassDelegate, mode: String, gain: Float = 1f) {
+    val rim = if (mode == "rim" || mode == "combined") gain else 0f
+    val outline = if (mode == "outline" || mode == "combined") gain else 0f
+    val circularProgram by lazy { RuntimeEffect.makeForShader(adaptiveEdgeShader()) }
+    val continuousProgram by lazy { RuntimeEffect.makeForShader(adaptiveEdgeShader(continuous = true)) }
+    runOnIdle {
+      delegate.experimentalRim = if (rim == 0f && outline == 0f) {
+        null
+      } else {
+        { source, layer, key ->
+          layer.alpha = 1f
+          val program = if (key.cornerRadii.isContinuous) continuousProgram else circularProgram
+          layer.renderEffect = createRuntimeShaderRenderEffect(program, arrayOf("content"), arrayOf(null)) {
+            setRimUniforms(key)
+            setFloatUniform("rimGain", rim)
+            setFloatUniform("outlineGain", outline)
+          }.asComposeRenderEffect()
+          recordGlassLayer(layer, key.coordinates.sampleSize.roundToIntSize()) { drawLayer(source) }
+        }
+      }
+      checkNotNull(effect.attachedContextForTest).invalidateDraw()
+    }
+  }
+
+  private fun androidx.compose.ui.test.ComposeUiTest.capture(): PixelMap = onNodeWithTag("matrix-root").captureToImage().toPixelMap()
+
+  private fun assertInterior(a: PixelMap, b: PixelMap) {
+    var difference = 0f
+    for (y in 32 until 64) for (x in 32 until 96) difference = maxOf(difference, channelDifference(a[x, y], b[x, y]))
+    assertThat(difference).isLessThanOrEqualTo(1f / 255f)
+  }
+
+  private fun maxDifference(a: PixelMap, b: PixelMap): Float {
+    assertThat(a.width).isEqualTo(b.width)
+    assertThat(a.height).isEqualTo(b.height)
+    var difference = 0f
+    for (y in 0 until a.height) for (x in 0 until a.width) difference = maxOf(difference, channelDifference(a[x, y], b[x, y]))
+    return difference
+  }
+
+  private fun channelDifference(a: Color, b: Color) = maxOf(abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha))
+
+  private fun save(pixels: PixelMap, path: String) {
+    val file = output?.resolve(path) ?: return
+    file.parentFile.mkdirs()
+    val image = BufferedImage(pixels.width, pixels.height, BufferedImage.TYPE_INT_ARGB)
+    for (y in 0 until pixels.height) for (x in 0 until pixels.width) image.setRGB(x, y, pixels[x, y].toArgb())
+    check(ImageIO.write(image, "png", file))
+  }
+}
