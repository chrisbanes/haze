+          val delta = abs((a ushr (8 * shift) and 255) - (b ushr (8 * shift) and 255))
+          if (x in 64 until 72 && y in 16 until 20) screenDifference = maxOf(screenDifference, delta)
+          if (x in 32 until 96 && y in 32 until 64) interiorDifference = maxOf(interiorDifference, delta)
+        }
+      }
+      assertThat(screenDifference).isGreaterThan(3)
+      assertThat(interiorDifference).isLessThanOrEqualTo(1)
+      val shifted = runBlocking { checkNotNull(delegate.layers.rim).toImageBitmap() }.toPixelMap()
+      var changed = 0f
+      var shiftError = 0f
+      var count = 0
+      for (y in 0 until fixedRim.height) for (x in 0 until fixedRim.width) {
