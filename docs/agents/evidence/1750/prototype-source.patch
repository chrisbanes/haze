+  private fun sourceUpdateLifecycle(pattern: Boolean) = runAndroidComposeUiTest<ComponentActivity> {
+    val state = HazeState()
+    val shift = mutableStateOf(0f)
+    val attached = mutableStateOf(true)
+    val effect = GlassRuntimeEffect().apply { appearanceReader = { GlassSystemAppearance.Light } }
