+      var left = 0
+      var right = 0
+      var leftDelta = 0f
+      var rightDelta = 0f
+      var error = 0f
+      for (y in 0 until fixedRim.height) for (x in 0 until fixedRim.width) {
+        val sx = 16f + (x + 0.5f - coordinates.materialOrigin.x) / coordinates.scaleFactor
+        val sy = 16f + (y + 0.5f - coordinates.materialOrigin.y) / coordinates.scaleFactor
+        if (sy >= 32f && sy < 64f && (sx >= 16f && sx < 20f || sx >= 108f && sx < 112f)) {
+          val alpha = fixedRim[x, y].alpha
+          if (alpha >= 0.05f) {
