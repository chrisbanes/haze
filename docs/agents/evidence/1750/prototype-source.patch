+@SdkSuppress(minSdkVersion = 33)
+class AdaptiveEdgePrototypeInstrumentationTest {
+  @get:Rule
+  val rule = createAndroidComposeRule<ComponentActivity>()
+
+  @Test
+  fun runtimeShader_srgbSplit_reportsChildAndLinearValues() {
+    assertThat(Build.VERSION.SDK_INT).isEqualTo(33)
+    val source = Bitmap.createBitmap(128, 96, Bitmap.Config.ARGB_8888)
+    assertThat(checkNotNull(source.colorSpace).isSrgb).isTrue()
+    for (y in 0 until 96) for (x in 0 until 128) {
+      val value = if (x < 64) 26 else 230
+      source.setPixel(x, y, android.graphics.Color.rgb(value, value, value))
+    }
+    val child = BitmapShader(source, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
+    val shader = RuntimeShader(
+      """
+      uniform shader content;
+      half4 main(float2 p) {
+        half4 sample = content.eval(p);
+        half3 linear = toLinearSrgb(sample.rgb / sample.a);
+        return half4(sample.r / sample.a, linear.r, 0, 1);
+      }
+      """.trimIndent(),
+    ).apply { setInputShader("content", child) }
+    var hardware = false
+    rule.setContent {
+      CompositionLocalProvider(LocalDensity provides Density(1f)) {
+        Box(
+          Modifier.size(128.dp, 96.dp).testTag("probe").drawBehind {
+            drawIntoCanvas { hardware = it.nativeCanvas.isHardwareAccelerated }
+            drawRect(ShaderBrush(shader))
+          },
+        )
+      }
+    }
+    val pixels = rule.onNodeWithTag("probe").captureToImage().toPixelMap()
+    assertThat(hardware).isTrue()
+    for ((x, encoded) in listOf(32 to 26, 96 to 230)) {
+      val color = pixels[x, 48]
+      val e = encoded / 255.0
+      val expected = ((e + 0.055) / 1.055).pow(2.4).toFloat()
+      assertThat(abs(color.red - e.toFloat())).isLessThanOrEqualTo(2f / 255f)
+      assertThat(abs(color.green - expected)).isLessThanOrEqualTo(2f / 255f)
+    }
+  }
+
+  @Test
+  fun runtimeShader_translucentAndTransparentInputs_unpremultiplyOrUseFixedStrength() {
+    assertThat(Build.VERSION.SDK_INT).isEqualTo(33)
+    val source = Bitmap.createBitmap(128, 96, Bitmap.Config.ARGB_8888)
+    assertThat(checkNotNull(source.colorSpace).isSrgb).isTrue()
+    for (y in 0 until 96) for (x in 0 until 64) {
+      source.setPixel(x, y, android.graphics.Color.argb(128, 128, 128, 128))
+    }
+    val child = BitmapShader(source, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
+    val shader = RuntimeShader(
+      """
+      uniform shader content;
+      half4 main(float2 p) {
+        half4 sample = content.eval(p);
+        half3 linear = sample.a > 0.0001 ? toLinearSrgb(sample.rgb / sample.a) : half3(1);
+        return half4(sample.a > 0.0001 ? sample.r / sample.a : 1,
+                     linear.r, sample.a > 0.0001 ? sample.a : 1, 1);
+      }
+      """.trimIndent(),
+    ).apply { setInputShader("content", child) }
+    var hardware = false
+    rule.setContent {
+      CompositionLocalProvider(LocalDensity provides Density(1f)) {
+        Box(
+          Modifier.size(128.dp, 96.dp).testTag("alpha-probe").drawBehind {
+            drawIntoCanvas { hardware = it.nativeCanvas.isHardwareAccelerated }
+            drawRect(ShaderBrush(shader))
+          },
+        )
+      }
+    }
+    rule.waitForIdle()
+    val pixels = rule.onNodeWithTag("alpha-probe").captureToImage().toPixelMap()
+    assertThat(hardware).isTrue()
+    val translucent = pixels[32, 48]
+    val encoded = 128.0 / 255.0
+    val linear = ((encoded + 0.055) / 1.055).pow(2.4).toFloat()
+    assertThat(abs(translucent.red - encoded.toFloat())).isLessThanOrEqualTo(2f / 255f)
+    assertThat(abs(translucent.green - linear)).isLessThanOrEqualTo(2f / 255f)
+    assertThat(abs(translucent.blue - encoded.toFloat())).isLessThanOrEqualTo(1f / 255f)
+    val transparent = pixels[96, 48]
+    assertThat(transparent.red).isEqualTo(1f)
+    assertThat(transparent.green).isEqualTo(1f)
+    assertThat(transparent.blue).isEqualTo(1f)
+  }
+
+  @Suppress("DEPRECATION")
+  @Test
+  fun runtimeGlass_splitSource_modulatesActualForeground() {
+    assertThat(Build.VERSION.SDK_INT).isEqualTo(33)
+    val state = HazeState()
+    val sourceShift = mutableStateOf(0f)
+    val effect = GlassRuntimeEffect().apply { appearanceReader = { GlassSystemAppearance.Light } }
+    val factory = HazeEffectFactory { effect }
+    val style = GlassStyle.regular.then {
+      shape(RoundedCornerShape(8.dp))
+      backgroundColor(Color.Transparent)
+    }
+    rule.setContent {
+      CompositionLocalProvider(LocalDensity provides Density(1f)) {
+        Box(Modifier.size(128.dp, 96.dp).testTag("glass-root").background(Color.Black)) {
+          Box(
+            Modifier.size(128.dp, 96.dp).hazeSource(state).drawBehind {
+              drawRect(Color(0.1f, 0.1f, 0.1f))
+              drawRect(Color(0.9f, 0.9f, 0.9f), topLeft = Offset(64f + sourceShift.value, 0f))
+            },
+          )
+          Box(Modifier.offset(16.dp, 16.dp).size(96.dp, 64.dp).hazeGlass(factory, HazeInput.Sources(state), style, HazePerformanceMode.Quality, true, null))
+        }
+      }
+    }
+    rule.waitForIdle()
+    val delegate = effect.delegate as RuntimeShaderGlassDelegate
+    val candidate = createRuntimeEffect(adaptiveEdgeShader())
+    var recordedKey: GlassRimEffectKey? = null
+    fun installAdaptive(gain: Float) {
+      delegate.experimentalRim = { source, layer, key ->
+        recordedKey = key
+        layer.alpha = 1f
+        layer.renderEffect = createRuntimeShaderRenderEffect(candidate, arrayOf("content"), arrayOf(null)) {
+          setRimUniforms(key)
+          setFloatUniform("rimGain", gain)
+          setFloatUniform("outlineGain", gain)
+        }.asComposeRenderEffect()
+        recordGlassLayer(layer, key.coordinates.sampleSize.roundToIntSize()) { drawLayer(source) }
+      }
+      checkNotNull(effect.attachedContextForTest).invalidateDraw()
+    }
+    fun install(gain: Float) {
+      if (gain.coerceIn(0f, 1f) == 0f) {
+        delegate.experimentalRim = null
+        checkNotNull(effect.attachedContextForTest).invalidateDraw()
+      } else {
+        installAdaptive(gain)
+      }
+    }
+    try {
+      val disabled = rule.onNodeWithTag("glass-root").captureToImage().toPixelMap()
