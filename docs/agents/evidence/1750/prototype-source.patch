+  @Suppress("DEPRECATION")
+  private fun mergedSplit(gap: Float) = runSkikoComposeUiTest(size = Size(128f, 96f), density = Density(1f)) {
+    val state = HazeState()
+    val effect = GlassRuntimeEffect()
+    val style = GlassStyle.regular.then {
+      backgroundColor(Color.Transparent)
+      edgeOutline(Color.Black.copy(alpha = 0.5f), 2.dp)
+    }
+    setContent {
+      CompositionLocalProvider(LocalSystemTheme provides SystemTheme.Light) {
+        Box(Modifier.size(128.dp, 96.dp).testTag("root").background(Color.Black)) {
+          Box(
+            Modifier.size(128.dp, 96.dp).hazeSource(state).drawBehind {
+              drawRect(Color(0.1f, 0.1f, 0.1f))
+              drawRect(Color(0.9f, 0.9f, 0.9f), topLeft = Offset(64f, 0f))
+            },
+          )
+          Box(
+            Modifier.offset(4.dp, 28.dp).size(120.dp, 40.dp).hazeGlass(
+              HazeEffectFactory { effect },
+              HazeInput.Sources(state),
+              style,
+              HazePerformanceMode.Quality,
+              true,
+              null,
+            ),
+          )
+        }
+      }
+    }
+    val left = (120f - 100f - gap) / 2f
+    fun field(separation: Float): GlassMergedField {
+      val memberLeft = (120f - 100f - separation) / 2f
+      return mergedField(
+        mergedMember(memberLeft, 10f, 50f, 20f, radius = 10f, tint = Color.Green),
+        mergedMember(memberLeft + 50f + separation, 10f, 50f, 20f, radius = 10f, tint = Color.Green),
+        mergeDistancePx = 16f,
+        opticalSize = Size(50f, 20f),
+      )
+    }
+    runOnIdle { effect.mergedField = field(gap) }
+    val fixed = onNodeWithTag("root").captureToImage().toPixelMap()
+    val fixedSeparate = if (gap == 6f) {
+      runOnIdle { effect.mergedField = field(10f) }
+      val result = onNodeWithTag("root").captureToImage().toPixelMap()
+      runOnIdle { effect.mergedField = field(6f) }
+      onNodeWithTag("root").captureToImage()
+      result
+    } else {
+      null
+    }
+    val delegate = effect.delegate as RuntimeShaderGlassDelegate
+    assertThat(supportsFusedGlassRenderEffect).isFalse()
+    assertThat(checkNotNull(effect.preparedRender).opticalKey.mergedField).isNotNull()
+    val centers = listOf((4f + left + 25f).toInt(), (4f + left + 50f + gap + 25f).toInt())
+    fun topology(pixels: PixelMap) {
+      val middle = pixels[64, 48]
+      if (gap == 6f) {
+        assertThat(middle.green).isGreaterThan(0.85f)
+        assertThat(middle.red).isLessThan(0.05f)
+      } else {
+        assertThat(abs(middle.red - middle.green)).isLessThanOrEqualTo(1f / 255f)
+        assertThat(abs(middle.red - middle.blue)).isLessThanOrEqualTo(1f / 255f)
+      }
+      for (x in centers) {
+        val member = pixels[x, 48]
+        assertThat(member.green).isGreaterThan(0.85f)
+        assertThat(member.red).isLessThan(0.05f)
+      }
+    }
+    topology(fixed)
+    val candidate = RuntimeEffect.makeForShader(adaptiveEdgeShader(merged = true))
+    try {
+      runOnIdle {
+        delegate.experimentalRim = { source, layer, key ->
+          layer.alpha = 1f
+          layer.renderEffect = createRuntimeShaderRenderEffect(candidate, arrayOf("content"), arrayOf(null)) {
+            setRimUniforms(key)
+            setFloatUniform("rimGain", 1f)
+            setFloatUniform("outlineGain", 1f)
+          }.asComposeRenderEffect()
+          recordGlassLayer(layer, key.coordinates.sampleSize.roundToIntSize()) { drawLayer(source) }
+        }
+        checkNotNull(effect.attachedContextForTest).invalidateDraw()
+      }
+      val adaptive = onNodeWithTag("root").captureToImage().toPixelMap()
+      topology(adaptive)
+      var difference = 0f
+      for (y in 26 until 70) for (x in 2 until 126) {
+        val a = fixed[x, y]
+        val b = adaptive[x, y]
+        difference = maxOf(difference, abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha))
+      }
+      for (x in centers) {
+        val a = fixed[x, 48]
+        val b = adaptive[x, 48]
+        assertThat(maxOf(abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha)))
+          .isLessThanOrEqualTo(1f / 255f)
+      }
+      if (gap == 6f) {
+        fun bandDifference(xs: IntRange, ys: IntRange): Float {
+          var max = 0f
+          for (y in ys) for (x in xs) {
+            val a = fixed[x, y]
+            val b = adaptive[x, y]
+            max = maxOf(max, abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha))
+          }
+          return max
+        }
+        val bridgeDifference = bandDifference(61..66, 38..57)
+        val outsideDifference = bandDifference(9..10, 46..49)
+        println("T3 merged bridgeBand=$bridgeDifference outsideBand=$outsideDifference")
+        assertThat(bridgeDifference).isGreaterThan(3f / 255f)
+        assertThat(outsideDifference).isGreaterThan(3f / 255f)
+      }
+      if (fixedSeparate != null) {
+        runOnIdle { effect.mergedField = field(10f) }
+        val separated = onNodeWithTag("root").captureToImage().toPixelMap()
+        for (pixels in listOf(fixedSeparate, separated)) {
+          val middle = pixels[64, 48]
+          assertThat(abs(middle.red - middle.green)).isLessThanOrEqualTo(1f / 255f)
+          assertThat(abs(middle.red - middle.blue)).isLessThanOrEqualTo(1f / 255f)
+          for (x in listOf(34, 94)) {
+            val member = pixels[x, 48]
+            assertThat(member.green).isGreaterThan(0.85f)
+            assertThat(member.red).isLessThan(0.05f)
+          }
+        }
+        var separatedDifference = 0f
+        for (y in 26 until 70) for (x in 2 until 126) {
+          val a = fixedSeparate[x, y]
+          val b = separated[x, y]
+          separatedDifference = maxOf(separatedDifference, abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha))
+        }
+        assertThat(separatedDifference).isGreaterThan(3f / 255f)
+        runOnIdle { effect.mergedField = field(6f) }
+        val restored = onNodeWithTag("root").captureToImage().toPixelMap()
+        var restoredDifference = 0f
+        for (y in 0 until 96) for (x in 0 until 128) {
+          val a = adaptive[x, y]
+          val b = restored[x, y]
+          restoredDifference = maxOf(restoredDifference, abs(a.red - b.red), abs(a.green - b.green), abs(a.blue - b.blue), abs(a.alpha - b.alpha))
+        }
+        println("T3 merged transition separated=$separatedDifference restored=$restoredDifference")
+        assertThat(restoredDifference).isLessThanOrEqualTo(1f / 255f)
+      }
+      println("T3 Skiko merged gap=$gap difference=$difference")
+      assertThat(difference).isGreaterThan(3f / 255f)
+    } finally {
+      runOnIdle { delegate.experimentalRim = null }
+    }
+  }
+}
