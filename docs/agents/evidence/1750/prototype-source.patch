+      rule.runOnIdle { sourceShift.value = 8f }
+      val shiftedScreen = rule.onNodeWithTag("glass-root").captureToImage().toPixelMap()
+      assertThat(delegate.experimentalForegroundDrawCount - beforeDraws).isLessThanOrEqualTo(1)
